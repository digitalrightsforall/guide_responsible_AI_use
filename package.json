{
  "name": "awesome-responsible-ai-skills",
  "version": "1.0.0",
  "description": "Curated directory of authentic open-source SKILL.md packages for responsible and safe AI use (Digital Rights for All / putongren.org).",
  "main": "site/index.html",
  "scripts": {
    "test": "node scripts/verify-data.js && node scripts/verify-guide.js",
    "test:remote": "node scripts/verify-remote.js",
    "build:guide": "node scripts/build-guide.js",
    "build": "node scripts/build-guide.js && node scripts/generate-readmes.js && node scripts/sync-layout.js",
    "sync:layout": "node scripts/sync-layout.js",
    "serve": "node scripts/serve.js",
    "build:css": "npx tailwindcss -i site/css/input.css -o site/css/tailwind.css --minify",
    "dev:css": "npx tailwindcss -i site/css/input.css -o site/css/tailwind.css --watch"
  },
  "keywords": [
    "responsible-ai",
    "ai-safety",
    "privacy",
    "fact-checking",
    "claude-skills",
    "agent-skills",
    "skill-md",
    "digital-rights"
  ],
  "author": "Responsible AI Use Contributors (putongren.org)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalrightsforall/guide_responsible_AI_use.git"
  },
  "homepage": "https://rai.putongren.org",
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
